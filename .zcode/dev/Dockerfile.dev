FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential ca-certificates bash && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:/usr/local/bin:$PATH
