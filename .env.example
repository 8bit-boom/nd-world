# Copy this file to .env and fill it in — or just run `bash scripts/setup.sh`,
# which does this for you (generating SECRET_KEY and prompting for your GM
# login) and starts the stack.

# Port nd-world is served on (http://<this-machine>:APP_PORT)
APP_PORT=8080

# Signs session cookies — generate a long random value, e.g.: openssl rand -hex 32
# Changing this logs everyone out. Keep it secret.
SECRET_KEY=change-me-to-a-random-value

# The GM account is bootstrapped from these on first start — there is no public
# signup. Everyone else joins as a player via a GM-issued invite link (World
# settings -> Invite Links, after logging in as the GM). Leave blank to skip
# bootstrapping (e.g. the GM account already exists from a previous run).
GM_EMAIL=
GM_PASSWORD=
GM_NAME=GM

# Set to true once nd-world is served over HTTPS (e.g. behind a Cloudflare
# Tunnel) — see docs/DEPLOYMENT.md Part B. Leave false for local http:// access;
# with it true, login won't stay signed in over a plain http:// connection.
COOKIE_SECURE=false

# AI chat (Ollama), audio-attachment transcription (Whisper), AI image
# generation (SwarmUI), the embedded Android app viewer, and the embedded
# Content Editor (see docs/DEPLOYMENT.md) are all optional — nd-world runs
# fine without any of them, it just shows those features as unavailable.
# Leave blank to skip all five (smaller download, no GPU/heavy containers
# needed). To enable one or more, list the profiles to start,
# comma-separated: ollama, whisper, swarmui, android, editor. Docker Compose
# reads this automatically — no extra flags needed.
COMPOSE_PROFILES=

# Where Ollama's text models, Whisper's transcription model, and SwarmUI's
# image checkpoints/LoRAs/VAEs are stored on the host — all three live under
# this one directory (in ollama/, whisper/, and swarmui/ subfolders) instead
# of separate Docker-managed volumes, so it's one place to back up, browse,
# or point at models you already have. Only matters if you've enabled the
# corresponding profile(s) above. Leave blank to default to ./ai-models next
# to this file.
AI_MODELS_DIR=

# Exact filename of the whisper.cpp model file in <AI_MODELS_DIR>/whisper/ —
# either downloaded through nd-world itself (AI page's Models tab, once the
# "whisper" profile is running) or placed there manually; see the "whisper"
# service in docker-compose.yml. Only matters if you've enabled the
# "whisper" profile above. This is only the FALLBACK now — once the GM
# clicks "★ Make active" on the Whisper tab, that choice (saved to a marker
# file in the shared volume, not here) takes over; this still matters for a
# fresh deployment before that's ever been clicked, or on a "whisper"
# service still running the pre-marker-aware entrypoint (see docs/DEPLOYMENT.md).
WHISPER_MODEL_FILE=ggml-large-v3-turbo.bin

# Only needed if your whisper.cpp server sees WHISPER_MODELS_DIR's contents
# at a different path than nd-world does — e.g. an externally-hosted
# instance not sharing nd-world's own volume layout. The default (/models)
# matches this repo's own docker-compose.yml/truenas-compose.yml as-is.
# WHISPER_SERVER_MODELS_DIR=/models

# How many seconds a single transcription request is allowed to run before
# giving up — this is actual Whisper inference time, not network latency,
# and CPU-only whisper.cpp can run well under realtime speed depending on
# your hardware and model size, so a full multi-hour session recording can
# legitimately take a long time to transcribe. Defaults to 8 hours if left
# blank; lower it if you'd rather fail fast than wait (a timeout here looks
# identical to "Whisper isn't configured" on the caller's side — an empty
# transcript, not an obvious error — so this defaults generously).
WHISPER_TIMEOUT_SECONDS=28800

# A recording longer than this is split into chunks before being sent to
# Whisper (see app/ai.py: _split_audio_into_chunks), each transcribed as
# its own request and then joined — avoids one very long recording tying
# up a single /inference call for hours with no progress signal in
# between. Floored at 60s; the app also enforces a separate, larger
# minimum recording duration below which chunking is skipped entirely
# even if this were set very low. Defaults to 600 (10 minutes) if unset.
# WHISPER_CHUNK_SECONDS=600

# How long a server shutdown waits for an in-flight background job
# (audio transcription/summarization, image generation, a chat
# completion — see app/job_shutdown.py) to reach its own checkpoint
# boundary before being cancelled outright. This is NOT "wait for the job
# to finish" — a single Whisper chunk can take minutes on CPU, far past
# any sane shutdown window — the job's own checkpoint from its last
# completed chunk is what actually survives, letting it resume on the
# next boot regardless of whether it got this grace window at all.
# Raising this much past docker-compose.yml's stop_grace_period (30s) minus
# ~13s (uvicorn's own connection drain + cancellation settling) is
# pointless — the container gets SIGKILLed before a longer wait would ever
# pay off. Defaults to 5 (seconds) if unset; the test suite sets this to 0.
# ND_JOB_STOP_GRACE_SECONDS=5

# Per-upload size caps, in bytes — MAX_UPLOAD_BYTES covers images/maps/etc,
# MAX_AUDIO_UPLOAD_BYTES covers audio clips AND every audio-transcription
# surface (Audio Library, Whisper Test tab, an AI Chat/Ask AI voice-memo
# attachment, a Session's audio recap upload) since they all reuse this one
# cap, MAX_AI_ATTACHMENT_BYTES covers a non-audio file attached to an AI
# Chat/Ask AI message (image, or .txt/.md/.pdf document). Defaults shown
# below (20 MB / 1 GB / 25 MB) apply if left blank — MAX_AUDIO_UPLOAD_BYTES
# defaults generously since a full multi-hour session recording can
# legitimately be this big. Every audio surface auto-splits a file over
# 100MB client-side and reassembles it here, so raising this actually helps
# even behind Cloudflare — MAX_UPLOAD_BYTES/MAX_AI_ATTACHMENT_BYTES's
# non-audio uploads don't get that treatment and stay capped by whatever
# Cloudflare allows through regardless of this setting; see "Upload size
# limit" in docs/DEPLOYMENT.md Part B if those still fail with a "413
# Payload Too Large" page after raising them.
MAX_UPLOAD_BYTES=20971520
MAX_AUDIO_UPLOAD_BYTES=1073741824
MAX_AI_ATTACHMENT_BYTES=26214400
# MAX_VIDEO_UPLOAD_BYTES covers the Video Library — deliberately a separate
# cap from MAX_AUDIO_UPLOAD_BYTES (video runs bigger than audio for the same
# length) so raising one doesn't silently raise the other. Same 100MB
# client-side auto-split/reassembly as the audio uploads above. Defaults to
# 2 GB if left blank.
MAX_VIDEO_UPLOAD_BYTES=2147483648

# Server-level Ollama tuning (only matters if you've enabled the "ollama"
# profile above) — these configure the Ollama container process itself.
# All optional; leave blank to use Ollama's own defaults. This is a
# different axis from nd-world's own Settings > System tab, which exposes
# separate per-request options (temperature, num_ctx, ...) that apply live
# without restarting anything.
#
# As of the ollama-config shared volume in docker-compose.yml/
# truenas-compose.yml, you don't have to edit these here at all — Settings
# > System > "Ollama server tuning" in nd-world can set every one of these
# (plus a few more) from the browser, and a value saved there wins over
# whatever's set below once the "ollama" service picks it up on its next
# restart. The vars below still work exactly as before if you'd rather
# manage them by hand instead — they just become the fallback default for
# any field the GM leaves blank on that page. Either way, changing any of
# these still needs an actual `docker compose restart ollama` to take
# effect — Ollama only reads them at start-up. See docs/DEPLOYMENT.md.
#
# f16 (default, most VRAM), q8_0, or q4_0 (least VRAM, some quality loss) —
# only takes effect when OLLAMA_FLASH_ATTENTION is also on.
OLLAMA_KV_CACHE_TYPE=
OLLAMA_FLASH_ATTENTION=
# How many requests one loaded model serves concurrently.
OLLAMA_NUM_PARALLEL=
# How many different models can be loaded into VRAM at once.
OLLAMA_MAX_LOADED_MODELS=
# How long an idle model stays loaded before being evicted, e.g. 5m, 1h,
# -1 (forever), 0 (unload immediately after each request).
OLLAMA_KEEP_ALIVE=
# Default context window size in tokens, if a request doesn't set its own
# num_ctx (see nd-world's Settings > System tab).
OLLAMA_CONTEXT_LENGTH=
OLLAMA_MAX_QUEUE=
OLLAMA_DEBUG=
# How long Ollama waits for a model to load before giving up. Raise on slow
# disks or very large models. Blank = 5m.
OLLAMA_LOAD_TIMEOUT=
# Bytes of VRAM per GPU to leave unused, e.g. for another app sharing the
# same card.
OLLAMA_GPU_OVERHEAD=
# Spread one model's layers across every visible GPU instead of filling one
# at a time.
OLLAMA_SCHED_SPREAD=
# Allow integrated GPUs to be used, not just discrete ones.
OLLAMA_IGPU_ENABLE=
# Vulkan backend (on by default on non-macOS).
OLLAMA_VULKAN=

# AMD (ROCm) GPU selection — e.g. an RX 9070 XT is gfx1201, natively
# supported on Linux via ROCm 7+, so HSA_OVERRIDE_GFX_VERSION shouldn't be
# needed; only set it if Ollama fails to detect the card correctly.
# ROCR_VISIBLE_DEVICES restricts Ollama to specific AMD GPU indices,
# CUDA_VISIBLE_DEVICES the NVIDIA equivalent, on a multi-GPU host. Leave all
# three blank on a single-GPU or CPU-only host — also uncomment the
# matching `deploy:`/`devices:`/`group_add:` block on the ollama service in
# docker-compose.yml (or truenas-compose.yml) to actually pass the GPU
# through to the container.
HSA_OVERRIDE_GFX_VERSION=
ROCR_VISIBLE_DEVICES=
CUDA_VISIBLE_DEVICES=
